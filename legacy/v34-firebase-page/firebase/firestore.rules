rules_version = '2';
// Africa Food Basket Platform: Firestore access rules.
// Public data: anyone reads. Users own their profile and saved views. Signed-in users submit corrections;
// verifiers review and publish; data stewards edit reference data; admins manage roles.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function rank(r) {
      return {'visitor': 0, 'member': 1, 'contributor': 2, 'verifier': 3, 'content_editor': 4,
              'data_steward': 5, 'platform_admin': 6, 'super_admin': 7}[r];
    }
    function atLeast(r) { return hasProfile() && rank(profile().role) >= rank(r); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /meta/{id}             { allow read: if true; allow write: if atLeast('data_steward'); }
    match /countries/{id}        { allow read: if true; allow write: if atLeast('data_steward'); }
    match /foods/{id}            { allow read: if true; allow write: if atLeast('data_steward'); }
    match /sources/{id}          { allow read: if true; allow write: if atLeast('data_steward'); }
    match /published_calls/{id}  { allow read: if true; allow write: if atLeast('verifier'); }
    match /published_events/{id} { allow read: if true; allow write: if atLeast('verifier'); }
    match /published_buyers/{id} { allow read: if true; allow write: if atLeast('verifier'); }

    // Anyone may create their own profile as a member; nobody can raise their own role.
    match /users/{uid} {
      allow read: if isMe(uid) || atLeast('platform_admin');
      allow create: if isMe(uid) && request.resource.data.role == 'member'
                    && request.resource.data.email == request.auth.token.email;
      allow update: if (isMe(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'createdAt']))
                    || atLeast('platform_admin');
      allow delete: if atLeast('super_admin');
      match /saved/{id} { allow read, write: if isMe(uid); }
    }

    match /submissions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || atLeast('verifier');
      allow update: if atLeast('verifier')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewer', 'reviewedAt', 'note']);
    }

    // Newsletter / launch sign-ups from the public page.
    match /signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'org', 'role', 'lang', 'createdAt'])
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200;
      allow read: if atLeast('platform_admin');
    }

    match /auditLog/{id} {
      allow create: if atLeast('verifier') && request.resource.data.actor == request.auth.uid;
      allow read: if atLeast('platform_admin');
    }

    match /{document=**} { allow read, write: if false; }
  }
}
