{
  "name": "africa-food-basket",
  "private": true,
  "version": "0.1.0",
  "description": "Africa Food Basket Platform by Cottid Africa",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "firebase emulators:exec --project demo-cottid --ui \"pnpm --filter @afb/web dev:emulators\"",
    "dev:web": "pnpm --filter @afb/web dev",
    "emulators": "firebase emulators:start --project demo-cottid",
    "build": "pnpm --filter @afb/web build && pnpm --filter @afb/functions build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check:locales": "tsx tools/check-locales.ts",
    "i18n:migrate": "tsx tools/migrate-i18n.ts legacy/platform_v33.html",
    "format": "prettier --write .",
    "deploy": "pnpm build && firebase hosting:channel:deploy next --expires 30d",
    "deploy:live": "pnpm build && firebase deploy --only hosting,firestore,storage",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:locales && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "firebase-tools": "^14.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
