{
  "name": "africa-food-basket",
  "private": true,
  "version": "0.1.0",
  "description": "Africa Food Basket Platform by Cottid Africa",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "firebase emulators:exec --project demo-cottid --ui \"pnpm --filter @afb/web dev:emulators\"",
    "dev:web": "pnpm --filter @afb/web dev",
    "emulators": "firebase emulators:start --project demo-cottid",
    "build": "pnpm data && pnpm --filter @afb/web build && pnpm --filter @afb/functions build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm data && pnpm -r --if-present test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cottid-rules \"vitest run --config tools/vitest.rules.config.ts\"",
    "e2e:auth": "pnpm --filter @afb/functions build && firebase emulators:exec --only auth,firestore,functions,storage --project demo-cottid \"pnpm seed:emulator && pnpm --filter @afb/web e2e:emu\"",
    "seed": "tsx tools/seed.ts",
    "seed:emulator": "tsx tools/seed.ts --project demo-cottid --emulator",
    "make-admin": "tsx tools/make-admin.ts",
    "check:locales": "tsx tools/check-locales.ts",
    "check:budget": "tsx tools/check-budget.ts",
    "extract": "tsx tools/extract.ts legacy/platform_v33.html",
    "build:data": "tsx tools/build-data.ts",
    "data": "pnpm extract && pnpm build:data",
    "capture": "tsx tools/capture-legacy.ts",
    "i18n:migrate": "tsx tools/migrate-i18n.ts legacy/platform_v33.html",
    "format": "prettier --write .",
    "deploy": "pnpm build && firebase hosting:channel:deploy next --expires 30d",
    "deploy:live": "pnpm build && firebase deploy --only hosting,functions,firestore,storage",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:locales && pnpm test && pnpm build && pnpm check:budget",
    "build:vercel": "pnpm data && pnpm --filter @afb/web build && node tools/vercel-output.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^4",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase": "^13",
    "firebase-admin": "^13",
    "firebase-tools": "^14.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
